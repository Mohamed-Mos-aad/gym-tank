generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  email     String   @unique
  password  String
  role      Role     @default(GYM_OWNER)
  isActive  Boolean  @default(true) // Added for User Management (Active/Disabled)

  gyms      Gym[]    // Allowed multiple branches for GYM_OWNER
  notifications Notification[] // Notifications for the user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM") // e.g. SYSTEM, GYM_REGISTRATION, SUBSCRIPTION
  link      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gym {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  name            String
  specialty       String?
  phone           String?
  email           String?
  address         String?
  state           String?
  systemLanguage  String   @default("ar")
  
  status          GymStatus @default(PENDING) // Added for Admin approval process

  startDate       DateTime @default(now())

  ownerId         String   @db.ObjectId // Removed @unique to allow 1-to-many
  owner           User     @relation(fields: [ownerId], references: [id])

  members         Member[]
  attendances     Attendance[]

   subscriptions   GymSubscription[] // Track gym's subscription to platform plans
   paymentRequests PaymentRequest[]  // Requests for plan activation/renewal

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GymSubscription {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  planName        String
  status          SubscriptionStatus @default(ACTIVE)

  startDate       DateTime @default(now())
  endDate         DateTime?

  gymId           String   @db.ObjectId
  gym             Gym      @relation(fields: [gymId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Member {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  phone     String?

  subscriptionType   String?
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  startDate DateTime @default(now())
  endDate   DateTime?

  gymId     String   @db.ObjectId
  gym       Gym      @relation(fields: [gymId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  GYM_OWNER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PAUSED
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  memberId  String   @db.ObjectId
  member    Member   @relation(fields: [memberId], references: [id])

  gymId     String   @db.ObjectId
  gym       Gym      @relation(fields: [gymId], references: [id])

  checkIn   DateTime @default(now())
  checkOut  DateTime?

  createdAt DateTime @default(now())
}

model Plan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  price       Float
  description String?
  features    String[]
  isPopular   Boolean  @default(false)
  paymentRequests PaymentRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  platformName      String   @default("GymTank")
  supportEmail      String?
  currency          String   @default("SAR")
  timezone          String   @default("GMT+03:00")
  maintenanceMode   Boolean  @default(false)
  
  // Default Limits
  maxMembersPerGym  Int      @default(500)
  maxCoachesPerGym  Int      @default(5)
  maxStorageMB      Int      @default(1024)
  
  // Financial
  vatRate           Float    @default(15.0)
  gracePeriodDays   Int      @default(3)
  reminderDays      Int      @default(3)

  updatedAt         DateTime @updatedAt
}

model PaymentRequest {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  
  gymId           String   @db.ObjectId
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  planId          String   @db.ObjectId
  plan            Plan     @relation(fields: [planId], references: [id])
  
  amount          Float
  method          String   // e.g. InstaPay, Vodafone Cash, Bank Transfer
  status          PaymentStatus @default(PENDING)
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String   @db.ObjectId
  action      String   // e.g. APPROVED_GYM, UPDATED_SETTINGS, REJECTED_PAYMENT
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model SupportInquiry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  subject     String?
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime @default(now())
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
}