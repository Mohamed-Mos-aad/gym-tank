generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  email     String   @unique
  password  String
  role      Role     @default(GYM_OWNER)
  isActive  Boolean  @default(true) // Added for User Management (Active/Disabled)

  gyms      Gym[]    // Allowed multiple branches for GYM_OWNER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gym {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  name            String
  specialty       String?
  phone           String?
  email           String?
  address         String?
  state           String?
  systemLanguage  String   @default("ar")
  
  status          GymStatus @default(PENDING) // Added for Admin approval process

  startDate       DateTime @default(now())

  ownerId         String   @db.ObjectId // Removed @unique to allow 1-to-many
  owner           User     @relation(fields: [ownerId], references: [id])

  members         Member[]
  attendances     Attendance[]

  subscriptions   GymSubscription[] // Track gym's subscription to platform plans

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GymSubscription {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId

  planName        String
  status          SubscriptionStatus @default(ACTIVE)

  startDate       DateTime @default(now())
  endDate         DateTime?

  gymId           String   @db.ObjectId
  gym             Gym      @relation(fields: [gymId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Member {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  phone     String?

  subscriptionType   String?
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  startDate DateTime @default(now())
  endDate   DateTime?

  gymId     String   @db.ObjectId
  gym       Gym      @relation(fields: [gymId], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  GYM_OWNER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PAUSED
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  memberId  String   @db.ObjectId
  member    Member   @relation(fields: [memberId], references: [id])

  gymId     String   @db.ObjectId
  gym       Gym      @relation(fields: [gymId], references: [id])

  checkIn   DateTime @default(now())
  checkOut  DateTime?

  createdAt DateTime @default(now())
}